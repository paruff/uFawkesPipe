{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp"
      ],
      "enabled": true
    },
    "serena": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "serena-agent",
        "serena",
        "start-mcp-server",
        "--project-from-cwd",
        "--context",
        "agent",
        "--open-web-dashboard",
        "False"
      ],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "Authorization": "Bearer {env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_TOKEN}"
      },
      "enabled": true
    },
    "sentry": {
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp",
      "headers": {
        "Authorization": "Bearer {env:SENTRY_API_KEY}"
      },
      "enabled": true
    },
    "woodpecker": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@ni-c/woodpecker-ci-mcp@0.4.0"
      ],
      "environment": {
        "WOODPECKER_URL": "{env:WOODPECKER_URL}",
        "WOODPECKER_TOKEN": "{env:WOODPECKER_MCP_TOKEN}",
        "WOODPECKER_READ_ONLY": "true",
        "WOODPECKER_ALLOW_TOOLS": "essential"
      },
      "enabled": true
    }
  }
}
