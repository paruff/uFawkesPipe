# Environment Configuration for uFawkesPipe
# Copy this file to .env and customize for your environment

# Woodpecker CI — GitHub OAuth
# Create a GitHub OAuth App: Settings → Developer settings → OAuth Apps → New OAuth App
# Homepage URL: http://localhost:8000
# Authorization callback URL: http://localhost:8000/authorize
WOODPECKER_GITHUB_CLIENT=your-github-oauth-client-id
WOODPECKER_GITHUB_SECRET=your-github-oauth-client-secret

# Woodpecker CI — Agent Secret (shared secret between server and agent)
WOODPECKER_AGENT_SECRET=changeme-woodpecker-agent-secret

# Woodpecker CI — Public host (change to your domain in production)
# WOODPECKER_HOST=https://ci.yourdomain.com

# DockerHub Credentials (used by Woodpecker agent for image push)
DOCKERHUB_USERNAME=your-dockerhub-username
DOCKERHUB_TOKEN=your-dockerhub-token-or-password

# Registry Configuration
DOCKER_REGISTRY=docker.io
REGISTRY_NAMESPACE=${DOCKERHUB_USERNAME}

# Default Builder for Cloud Native Buildpacks
CNB_BUILDER=paketobuildpacks/builder:base

# Kubernetes Configuration (for promotion path)
# K8S_CLUSTER_URL=https://kubernetes.default.svc
# K8S_NAMESPACE=ufawkespipe
# K8S_SERVICE_ACCOUNT_TOKEN=

# Optional: Slack/Teams Notifications
# SLACK_WEBHOOK_URL=
# TEAMS_WEBHOOK_URL=
