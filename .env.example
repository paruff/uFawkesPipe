# uFawkesPipe — required environment variables
# Copy to .env and fill in real values before running make up
#
# Suite mode (make up-suite) also requires uFawkesRes and uFawkesObs:
#   cd ../uFawkesRes && make up
#   cd ../uFawkesObs && make up

# =============================================================================
# Core — required for both standalone and suite mode
# =============================================================================

# Woodpecker CI — GitHub OAuth App credentials
# Create at: https://github.com/settings/developers → OAuth Apps
WOODPECKER_GITHUB_CLIENT=your_github_oauth_client_id
WOODPECKER_GITHUB_SECRET=your_github_oauth_client_secret

# Woodpecker agent shared secret — generate with: openssl rand -hex 32
WOODPECKER_AGENT_SECRET=changeme

# Woodpecker server URL (must be accessible from GitHub webhooks)
# For local dev: http://localhost:8000
# For production: https://your.domain.com
WOODPECKER_HOST=http://localhost:8000

# Host ports, for a Docker host where the defaults are taken (e.g. an existing service on
# 8000, 9000 and 9443). Change the host side only; container ports stay as they are.
WOODPECKER_UI_PORT=8000
WOODPECKER_GRPC_PORT=9000

# Optional Docker UI (Arcane, `make up-ui`): port and 32-char encryption key (openssl rand -hex 16)
ARCANE_PORT=3552
ARCANE_ENCRYPTION_KEY=

# SonarQube admin password (change on first login)
SONARQUBE_ADMIN_PASSWORD=changeme

# Container registry (for image push steps in pipelines)
REGISTRY_USERNAME=your_dockerhub_username
REGISTRY_TOKEN=your_dockerhub_access_token

# DefectDojo API token (for security scan ingestion into DefectDojo)
# Any 40-char hex string (openssl rand -hex 20); the security profile's
# defectdojo-initializer creates the admin token with this exact value.
DOJO_API_TOKEN=your_defectdojo_api_token

# DefectDojo/Infisical embedded postgres passwords (standalone mode only)
DOJO_DB_PASSWORD=changeme
DOJO_ADMIN_PASSWORD=changeme
INFISICAL_DB_PASSWORD=changeme

# DefectDojo Django secret/AES keys — generate with: openssl rand -hex 32
DEFECTDOJO_SECRET_KEY=changeme
DEFECTDOJO_AES_KEY=changeme

# Infisical encryption/auth secrets — generate with: openssl rand -hex 32
INFISICAL_ENCRYPTION_KEY=changeme
INFISICAL_AUTH_SECRET=changeme

# Falco webhook URL for runtime security alerts (optional)
FALCO_WEBHOOK_URL=

# =============================================================================
# Suite mode — only required for make up-suite (connects to uFawkesRes)
# =============================================================================

# Shared with uFawkesRes — must match POSTGRES_PASSWORD in uFawkesRes/.env
POSTGRES_PASSWORD=changeme

# Shared with uFawkesRes — must match VALKEY_PASSWORD in uFawkesRes/.env
VALKEY_PASSWORD=changeme

# Woodpecker Prometheus metrics token (optional, enables /metrics endpoint)
WOODPECKER_METRICS_TOKEN=

# Deployment environment label for OTEL events
UFAWKES_ENVIRONMENT=development

# Observability — OTEL Collector endpoint for deployment events
# Suite mode: http://otel-collector:4318
OTEL_ENDPOINT=your_otel_endpoint

# Optional auth headers for OTEL endpoint (e.g., "Authorization: Bearer <token>")
OTEL_HEADERS=your_otel_headers

# Woodpecker MCP server (read-only, see docs/ARCHITECTURE.md). Use a personal access token
# from a NON-admin Woodpecker user; never the admin token.
WOODPECKER_URL=http://localhost:8000
WOODPECKER_MCP_TOKEN=your_non_admin_woodpecker_token
