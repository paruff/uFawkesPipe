# uFawkesPipe — required environment variables
# Copy to .env and fill in real values before running make up
#
# Suite mode (make up-suite) also requires uFawkesRes and uFawkesObs:
#   cd ../uFawkesRes && make up
#   cd ../uFawkesObs && make up

# =============================================================================
# Core — required for both standalone and suite mode
# =============================================================================

# Woodpecker CI — GitHub OAuth App credentials
# Create at: https://github.com/settings/developers → OAuth Apps
WOODPECKER_GITHUB_CLIENT=your_github_oauth_client_id
WOODPECKER_GITHUB_SECRET=your_github_oauth_client_secret

# Woodpecker agent shared secret — generate with: openssl rand -hex 32
WOODPECKER_AGENT_SECRET=changeme

# Woodpecker server URL (must be accessible from GitHub webhooks)
# For local dev: http://localhost:8000
# For production: https://your.domain.com
WOODPECKER_HOST=http://localhost:8000

# SonarQube admin password (change on first login)
SONARQUBE_ADMIN_PASSWORD=changeme

# Container registry (for image push steps in pipelines)
REGISTRY_USERNAME=your_dockerhub_username
REGISTRY_TOKEN=your_dockerhub_access_token

# DefectDojo API token (for security scan ingestion into DefectDojo)
# Generate at: your-defectdojo-instance/api/v2/api-token/
DOJO_API_TOKEN=your-defectdojo-api-token

# =============================================================================
# Suite mode — only required for make up-suite (connects to uFawkesRes)
# =============================================================================

# Shared with uFawkesRes — must match POSTGRES_PASSWORD in uFawkesRes/.env
POSTGRES_PASSWORD=changeme

# Woodpecker Prometheus metrics token (optional, enables /metrics endpoint)
WOODPECKER_METRICS_TOKEN=

# Deployment environment label for OTEL events
UFAWKES_ENVIRONMENT=development
