# Copy to .env (gitignored). The token is a one-hour registration token:
#   gh api -X POST repos/<owner>/<repo>/actions/runners/registration-token --jq .token
RUNNER_REPO_URL=https://github.com/paruff/uFawkesPipe
RUNNER_NAME=ufawkes-nas
RUNNER_TOKEN=
# Extra labels, comma separated; the runner always has self-hosted and pipe-ci.
RUNNER_EXTRA_LABELS=synology
# Docker socket on the host: /var/run/docker.sock on the NAS,
# /Users/<you>/.colima/default/docker.sock on the MacBook (colima).
DOCKER_SOCKET=/var/run/docker.sock
