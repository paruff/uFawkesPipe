#!/usr/bin/env bash
# pipe-ci — local outage CLI of ufawkes-ci (spec §4.4). Thin wrappers over the
# preinstalled toolchain, run from the mounted workspace (-v "$PWD:/src" -w /src).
# Each subcommand exits with the underlying tool's code; nothing is swallowed.
#
# Exit codes of its own: 64 unknown subcommand, 66 no unit-test entrypoint found,
# 1 release mismatch, 67 release-match could not run (named on stderr).
set -euo pipefail

RULES=/opt/ufawkes/semgrep-rules
BASELINE=/opt/ufawkes/pre-commit/baseline.yaml

usage() {
  cat >&2 << 'USAGE'
usage: pipe-ci <subcommand> [args]
  pre-commit [--baseline] [--stages s1,s2]
                               pre-commit run --all-files (default: the repo's default stages).
                               --baseline: core's baseline hooks (language: system), no network needed
  pre-push [base]              pre-commit over base..HEAD (default base: origin/main)
  preflight                    pre-commit --all-files, then the commit-msg check on HEAD
  lint                         actionlint, shellcheck, hadolint, ruff on the files that exist
  security                     gitleaks + trivy fs + semgrep (local ruleset, offline)
  unit                         make test, or scripts/run-unit-tests.sh
  release-match [devcontainer] fail if this image's fawkes-core is not the release the
                               devcontainer's fawkes-space pins (default .devcontainer/devcontainer.json)
  exec <cmd...>                run any command in the image environment
USAGE
}

run_pre_commit() { # run_pre_commit <config-args> [stage...] -> once per stage (once if none)
  local config="$1"
  shift
  local -a args=()
  [[ -n "${config}" ]] && args=(-c "${config}")
  if [[ $# -eq 0 ]]; then
    pre-commit run "${args[@]}" --all-files
    return
  fi
  local stage
  for stage in "$@"; do
    pre-commit run "${args[@]}" --all-files --hook-stage "${stage}"
  done
}

cmd_pre_commit() {
  local config="" stages=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --baseline) config="${BASELINE}" ;;
      --stages)
        IFS=',' read -r -a stages <<< "${2:?--stages needs a comma-separated list}"
        shift
        ;;
      *)
        usage
        return 64
        ;;
    esac
    shift
  done
  run_pre_commit "${config}" "${stages[@]}"
}

cmd_preflight() {
  pre-commit run --all-files
  local msg
  msg="$(mktemp)"
  git log -1 --format=%B > "${msg}"
  pre-commit run --hook-stage commit-msg --commit-msg-filename "${msg}"
}

cmd_lint() { # every linter runs; the exit code is non-zero if any failed
  local rc=0 files
  files="$(git ls-files '.github/workflows/*.yml' '.github/workflows/*.yaml')"
  if [[ -n "${files}" ]]; then
    # shellcheck disable=SC2086  # one argument per file; paths have no spaces
    actionlint ${files} || rc=1
  fi
  files="$(git ls-files '*.sh')"
  if [[ -n "${files}" ]]; then
    # shellcheck disable=SC2086
    shellcheck --severity=warning ${files} || rc=1
  fi
  files="$(git ls-files '*Dockerfile' 'Dockerfile*')"
  if [[ -n "${files}" ]]; then
    # shellcheck disable=SC2086
    hadolint ${files} || rc=1
  fi
  if [[ -n "$(git ls-files '*.py')" ]]; then
    ruff check . || rc=1
  fi
  return "${rc}"
}

cmd_security() {
  gitleaks detect --no-banner --redact
  # Offline by design: the vulnerability DB was baked into the image at build time.
  trivy fs --skip-db-update --skip-java-db-update --exit-code 1 --severity HIGH,CRITICAL .
  semgrep scan --config "${RULES}" --error --metrics=off --disable-version-check .
}

# The fawkes-core digest this image was built FROM must be the digest of the fawkes-core
# tagged like the fawkes-space the devcontainer pins: one uFawkesAI release for CI and for
# development (ci-pipeline spec R4). Reads the public registry; needs network.
cmd_release_match() {
  local devcontainer="${1:-.devcontainer/devcontainer.json}"
  local base_file="${PIPE_CI_BASE_DIGEST_FILE:-/etc/ufawkes/ci-base-digest}"
  local registry="${PIPE_CI_REGISTRY:-https://ghcr.io}"
  if [[ ! -f "${devcontainer}" ]]; then
    echo "pipe-ci: release-match: no ${devcontainer}; nothing to compare" >&2
    return 67
  fi
  [[ -s "${base_file}" ]] || {
    echo "pipe-ci: release-match: ${base_file} is missing: this image does not record its base" >&2
    return 67
  }
  local have tag want token
  have="$(< "${base_file}")"
  # grep exits 1 when nothing matches; an empty tag is reported below, by name.
  tag="$(grep -oE 'ghcr\.io/paruff/fawkes-space:[0-9A-Za-z._-]+' "${devcontainer}" | head -1 | cut -d: -f2)" || tag=""
  if [[ -z "${tag}" ]]; then
    echo "pipe-ci: release-match: ${devcontainer} does not pin ghcr.io/paruff/fawkes-space:<release>" >&2
    return 67
  fi
  token="$(curl -fsSL "${registry}/token?service=ghcr.io&scope=repository:paruff/fawkes-core:pull" | jq -er .token)" || {
    echo "pipe-ci: release-match: cannot get a registry token" >&2
    return 67
  }
  want="$(curl -fsSI -H "Authorization: Bearer ${token}" \
    -H "Accept: application/vnd.oci.image.index.v1+json, application/vnd.docker.distribution.manifest.list.v2+json, application/vnd.oci.image.manifest.v1+json" \
    "${registry}/v2/paruff/fawkes-core/manifests/${tag}" | awk -F': ' 'tolower($1) == "docker-content-digest" {print $2}' | tr -d '\r')" || {
    echo "pipe-ci: release-match: cannot resolve fawkes-core:${tag}" >&2
    return 67
  }
  if [[ "${have}" != "${want}" ]]; then
    echo "::error::ufawkes-ci is built on fawkes-core ${have}, but the devcontainer pins fawkes-space:${tag}, whose fawkes-core is ${want:-unknown}. CI and development must come from one uFawkesAI release." >&2
    return 1
  fi
  echo "release match: fawkes-core:${tag} = ${have}"
}

cmd_unit() {
  if [[ -f Makefile ]] && make -n test > /dev/null 2>&1; then
    make test
  elif [[ -x scripts/run-unit-tests.sh ]]; then
    scripts/run-unit-tests.sh
  else
    echo "pipe-ci: no unit-test entrypoint (a 'test' make target or scripts/run-unit-tests.sh)" >&2
    return 66
  fi
}

sub="${1:-}"
[[ $# -gt 0 ]] && shift
case "${sub}" in
  pre-commit) cmd_pre_commit "$@" ;;
  pre-push) pre-commit run --from-ref "${1:-origin/main}" --to-ref HEAD ;;
  preflight) cmd_preflight ;;
  lint) cmd_lint ;;
  security) cmd_security ;;
  unit) cmd_unit ;;
  release-match) cmd_release_match "$@" ;;
  exec)
    [[ $# -gt 0 ]] || {
      usage
      exit 64
    }
    exec "$@"
    ;;
  *)
    usage
    exit 64
    ;;
esac
